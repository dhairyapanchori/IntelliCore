# ==============================================================================
# IntelliCore Express Backend - Environment Configuration Example
# ==============================================================================
# Copy this file to .env before starting local development or running migrations:
# cp .env.example .env

# PostgreSQL connection string (Ensure Postgres is running locally on port 5432)
# Required format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/intellicore"

# Redis connection URL for BullMQ document background processing queue
# Note: In development, Express will fail gracefully with a warning if Redis is offline.
REDIS_URL="redis://127.0.0.1:6379"

# Security & Authentication Tokens
JWT_SECRET="intellicore_secret_key_development_only"
JWT_EXPIRE="7d"

# Express API Port
PORT=8001
